# ==========================================
# Database Configuration (Pilih MySQL atau Supabase)
# ==========================================

# 1. Konfigurasi MySQL / MariaDB Lokal (Default Aktif)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warungppl_db

# 2. Konfigurasi Supabase Cloud (Opsional jika ingin beralih ke Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (SANGAT PENTING: Digunakan di sisi server Next.js untuk bypass RLS secara aman)

# ==========================================
# Email SMTP Configuration (Kirim Email Reset Password)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Wadira Warung Digital" <noreply@wadira.id>

# ==========================================
# Security & Session Authentication
# ==========================================
SESSION_SECRET=ganti-dengan-string-acak-rahasia-minimal-32-karakter-keamanan
RESET_TOKEN_SECRET=ganti-dengan-string-acak-rahasia-reset-password-minimal-32-karakter

# ==========================================
# Midtrans Payment Gateway Configuration
# ==========================================
# Dapatkan Server Key & Client Key dari Midtrans Dashboard (Sandbox / Production)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google.

# ==========================================
# WhatsApp Bot Service (wa-server)
# ==========================================
WA_SERVER_URL=http://localhost:3001
WA_API_KEY=wadira-internal-wa-secret-key



