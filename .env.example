# ==========================================
# Konfigurasi Supabase Cloud (PostgreSQL)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Konfigurasi MySQL / MariaDB Lokal (Fallback)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warungppl_db

# ==========================================
# Payment Gateway - Midtrans (Sandbox Mode)
# ==========================================
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# Email SMTP Configuration (Gmail App Password)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Wadira Warung Digital" <your-email@gmail.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Security & Session Keys (JWT / Cookies)
# ==========================================
SESSION_SECRET=your-random-32char-secret-key-here
RESET_TOKEN_SECRET=your-random-32char-token-secret-here

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ==========================================
# Google Gemini AI API Key (Chatbot & AI Tools)
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
