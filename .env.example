# ==========================================
# Database Configuration (Pilih MySQL atau Supabase)
# ==========================================

# 1. Konfigurasi MySQL / MariaDB Lokal (Default Aktif)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warungppl_db

# 2. Konfigurasi Supabase Cloud (Opsional jika ingin beralih ke Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# Email SMTP Configuration (Kirim Email Reset Password)
